#include <iostream>
#include <ctime>
#include <cstdlib>
#include <clocale>
#include <limits>

using namespace std;

enum SELECT
{
    RANDOM = 0,
    MANUALLY = 1
};

void checkN(const int n);
size_t getSize();
int getNumber();
void printArray(const int* arr, const int n);
void fillArrayRandom(int* arr, const int n, const int min, const int max);
void fillArray(int* arr, const int n, const int min, const int max);
void checkRange(const int min, const int max);
void replaceLastKWithOpposite(int* arr, const int n, const size_t k);
void printIndicesOfMultiplesOfThree(const int* arr, const int n);
int findPairWithSum(const int* arr, const int n, const int target);

/**
 * @brief Создает копию массива
 * @param source Исходный массив
 * @param n Размер массива
 * @return Указатель на новый массив-копию
 */
int* copyArray(const int* source, const int n) {
    int* newArray = new int[n];
    for (int i = 0; i < n; ++i) {
        newArray[i] = source[i];
    }
    return newArray;
}

int main() {
    setlocale(LC_ALL, "Russian");
    
    // Получаем размер массива
    int n = getSize();
    
    // Создаем оригинальный массив
    int* originalArray = new int[n];

    // Заполняем массив
    cout << "Введите минимальное значение диапазона: ";
    int minValue = getNumber();
    cout << "Введите максимальное значение диапазона: ";
    int maxValue = getNumber();
    checkRange(minValue, maxValue);

    cout << "Введите выбор для заполнения массива: " << endl
         << RANDOM << " Для случайного заполнения" << endl
         << MANUALLY << " Для ручного заполнения" << endl;

    int choice = getNumber();

    switch (static_cast<SELECT>(choice)) {
    case RANDOM:
        fillArrayRandom(originalArray, n, minValue, maxValue);
        break;
    case MANUALLY:
        fillArray(originalArray, n, minValue, maxValue);
        break;
    default:
        cout << "Ваш выбор неверен" << endl;
        delete[] originalArray;
        return -1;
    }

    // Создаем рабочую копию массива
    int* workArray = copyArray(originalArray, n);

    cout << "\nИсходный массив:" << endl;
    printArray(originalArray, n);

    cout << "\nРабочая копия массива:" << endl;
    printArray(workArray, n);

    // Операция 1: Замена последних k элементов
    cout << "\nВведите количество последних элементов для замены: ";
    int k = getNumber();
    replaceLastKWithOpposite(workArray, n, k);
    cout << "Массив после замены последних " << k << " элементов:" << endl;
    printArray(workArray, n);

    // Операция 2: Поиск элементов, кратных 3
    cout << "\nИндексы элементов, кратных 3:" << endl;
    printIndicesOfMultiplesOfThree(workArray, n);

    // Операция 3: Поиск пары с заданной суммой
    cout << "\nВведите целевую сумму для поиска пары: ";
    int target = getNumber();
    int pairIndex = findPairWithSum(workArray, n, target);
    if (pairIndex != -1) {
        cout << "Найдена пара соседних элементов с суммой " << target
             << " на индексах: " << pairIndex << " и " << pairIndex + 1 << endl;
    } else {
        cout << "Пара соседних элементов с суммой " << target << " не найдена." << endl;
    }

    // Показываем, что оригинальный массив не изменился
    cout << "\nОригинальный массив (остался без изменений):" << endl;
    printArray(originalArray, n);

    // Освобождаем память
    delete[] originalArray;
    delete[] workArray;

    return 0;
}

// Реализации функций:

void checkN(const int n) {
    if (n <= 0) {
        cerr << "Размер массива должен быть положительным!" << endl;
        exit(EXIT_FAILURE);
    }
}

size_t getSize() {
    int n;
    cout << "Введите размер массива: ";
    while (!(cin >> n) || n <= 0) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Ошибка ввода. Пожалуйста, введите положительное целое число: ";
    }
    return static_cast<size_t>(n);
}

int getNumber() {
    int num;
    while (!(cin >> num)) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Ошибка ввода. Пожалуйста, введите целое число: ";
    }
    return num;
}

void printArray(const int* arr, const int n) {
    for (int i = 0; i < n; ++i) {
        cout << "arr[" << i << "] = " << arr[i] << endl;
    }
}

void fillArrayRandom(int* arr, const int n, const int min, const int max) {
    srand(time(nullptr));
    for (int i = 0; i < n; ++i) {
        arr[i] = rand() % (max - min + 1) + min;
    }
}

void fillArray(int* arr, const int n, const int min, const int max) {
    cout << "Введите " << n << " элементов массива (в диапазоне [" << min << ", " << max << "]):" << endl;
    for (int i = 0; i < n; ++i) {
        while (true) {
            cout << "Элемент " << i << ": ";
            arr[i] = getNumber();
            if (arr[i] >= min && arr[i] <= max) {
                break;
            }
            cout << "Число должно быть в диапазоне [" << min << ", " << max << "]. Попробуйте снова." << endl;
        }
    }
}

void checkRange(const int min, const int max) {
    if (min > max) {
        cerr << "Минимальное значение не может быть больше максимального!" << endl;
        exit(EXIT_FAILURE);
    }
}

void replaceLastKWithOpposite(int* arr, const int n, const size_t k) {
    if (k > static_cast<size_t>(n)) {
        cout << "k превышает размер массива. Будут изменены все элементы." << endl;
        for (int i = 0; i < n; ++i) {
            arr[i] = -arr[i];
        }
    } else {
        for (size_t i = n - k; i < static_cast<size_t>(n); ++i) {
            arr[i] = -arr[i];
        }
    }
}

void printIndicesOfMultiplesOfThree(const int* arr, const int n) {
    cout << "Индексы элементов, кратных 3: ";
    bool found = false;
    for (int i = 0; i < n; ++i) {
        if (arr[i] % 3 == 0) {
            cout << i << " ";
            found = true;
        }
    }
    if (!found) {
        cout << "элементов, кратных 3, не найдено";
    }
    cout << endl;
}

int findPairWithSum(const int* arr, const int n, const int target) {
    for (int i = 0; i < n - 1; ++i) {
        if (arr[i] + arr[i + 1] == target) {
            return i;
        }
    }
    return -1;
}
